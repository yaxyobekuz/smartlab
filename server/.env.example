NODE_ENV=development
PORT=5000

# MongoDB
MONGO_URL=mongodb://127.0.0.1:27017/app_name

# JWT
JWT_ACCESS_SECRET=replace_me_access
JWT_REFRESH_SECRET=replace_me_refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Cookie
COOKIE_SECRET=replace_me_cookie
COOKIE_DOMAIN=localhost

# CORS
CLIENT_URL=http://localhost:5173

# OpenAI (AI yordamchi - chat)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Gemini (AI kimyoviy reaksiya)
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-2.5-flash
